<Window x:Class="MarkPort.App.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/MarkPort.ico" Title="{DynamicResource Conn_Title}" Height="560" Width="860" MinHeight="460" MinWidth="700"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 接続の一覧 -->
    <GroupBox Grid.Row="0" Grid.Column="0" Header="{DynamicResource Conn_List}" Padding="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="0,0,0,6">
          <Run Text="{DynamicResource Conn_InUse}" />
          <Run Text="{Binding InUse, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>
        <ListBox Grid.Row="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="{DynamicResource Conn_Add}" Command="{Binding AddCommand}" Click="OnAddClicked" Padding="10,3" Margin="0,0,6,0" />
          <Button Content="{DynamicResource Conn_Remove}" Command="{Binding RemoveCommand}" Padding="10,3" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <!-- 選んだ接続 -->
    <GroupBox Grid.Row="0" Grid.Column="1" Header="{DynamicResource Conn_Selected}" Padding="10" Margin="10,0,0,0" IsEnabled="{Binding HasSelection}">
      <Grid DataContext="{Binding Selected}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource Conn_Name}" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="URL" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
        <TextBlock Grid.Row="2" Text="{DynamicResource Conn_Model}" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Model, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
        <TextBlock Grid.Row="3" Text="{DynamicResource Conn_Timeout}" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TimeoutText, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <TextBlock Grid.Row="4" Text="{DynamicResource Conn_ApiKeyEnv}" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ApiKeyEnv, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"
                 ToolTip="{DynamicResource Conn_ApiKeyEnvTip}" />
        <TextBlock Grid.Row="5" Text="{DynamicResource Conn_ApiKey}" VerticalAlignment="Top" Margin="0,4,10,0" />
        <StackPanel Grid.Row="5" Grid.Column="1">
          <PasswordBox x:Name="KeyBox" PasswordChanged="OnKeyChanged" />
          <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}">
            <Run Text="{DynamicResource Conn_State}" />
            <Run Text="{Binding KeyState, Mode=OneWay}" />
            <Run Text="{DynamicResource Conn_KeyNote}" />
          </TextBlock>
        </StackPanel>
      </Grid>
    </GroupBox>

    <!-- 使う・チェック -->
    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <Button Content="{DynamicResource Conn_Use}" Command="{Binding UseCommand}" Padding="12,4" Margin="0,0,8,0" />
        <Button Content="{DynamicResource Conn_CheckConnection}" Command="{Binding CheckConnectionCommand}" Padding="12,4" Margin="0,0,8,0" />
        <Button Content="{DynamicResource Conn_CheckImage}" Command="{Binding CheckImageCommand}" Padding="12,4" />
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,8,0,0">
        <TextBlock Text="{Binding ConnectionResult}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ImageResult}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock Text="{Binding Problems}" TextWrapping="Wrap" Foreground="{DynamicResource FailedBrush}" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
