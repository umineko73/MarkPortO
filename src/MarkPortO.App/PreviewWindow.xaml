<Window x:Class="MarkPortO.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarkPortO.App"
        Icon="Assets/MarkPortO.ico" Height="936" Width="1500" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner" KeyDown="OnKeyDown" PreviewKeyDown="OnPreviewKeyDown" PreviewMouseWheel="OnWheel">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210" MinWidth="120" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- The pages -->
    <ListBox x:Name="PageList" Grid.Column="0" SelectionChanged="OnPageChanged" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel LastChildFill="True">
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" DockPanel.Dock="Left" IsChecked="{Binding Marked, Mode=OneWay}" IsEnabled="{Binding CanMark}" VerticalAlignment="Center" Margin="0,0,6,0"
                      PreviewMouseLeftButtonDown="OnPageMarkClick" ToolTip="{DynamicResource Preview_PageMarkTip}" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- The commands in one band: each group has a short label before it and a thin line after it -->
      <Border Grid.Row="0" Margin="0,0,0,6" Padding="8,4" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <Border.Resources>
          <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
          </Style>
          <Style x:Key="GroupLine" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
          </Style>
          <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
          </Style>
          <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="ContentTemplate">
              <Setter.Value>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center" Margin="0,1,7,0" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Border.Resources>
        <WrapPanel>
          <!-- Files and following the conversion -->
          <StackPanel Orientation="Horizontal" Margin="0,2">
            <Button x:Name="PrevFileButton" Style="{StaticResource IconButton}" Content="&#xE76B;" Click="OnPrevFile" ToolTip="{DynamicResource Preview_PrevFile}" />
            <Button x:Name="NextFileButton" Style="{StaticResource IconButton}" Content="&#xE76C;" Click="OnNextFile" Margin="4,0,10,0" ToolTip="{DynamicResource Preview_NextFile}" />
            <Button Style="{StaticResource GlyphButton}" Tag="&#xE72C;" Content="{DynamicResource Preview_Refresh}" Click="OnRefresh" Margin="0,0,10,0" />
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" x:Name="FollowBox" Content="{DynamicResource Preview_Follow}" VerticalAlignment="Center" />
          </StackPanel>
          <Rectangle Style="{StaticResource GroupLine}" />
          <!-- Marks for reading again (FR-138) -->
          <StackPanel Orientation="Horizontal" Margin="0,2">
            <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Preview_GroupReread}" />
            <Button x:Name="MarkPageButton" Style="{StaticResource GlyphButton}" Tag="&#xE7C1;" Content="{DynamicResource Preview_MarkPage}" Click="OnMarkPage" Margin="0,0,6,0"
                    ToolTip="{DynamicResource Preview_MarkPageTip}" />
            <Button x:Name="MarkFailedButton" Style="{StaticResource GlyphButton}" Tag="&#xE7BA;" Content="{DynamicResource Preview_MarkFailed}" Click="OnMarkFailed"
                    ToolTip="{DynamicResource Preview_MarkFailedTip}" />
          </StackPanel>
          <Rectangle Style="{StaticResource GroupLine}" />
          <!-- How the panes are placed, which are shown, and how the Markdown is shown -->
          <StackPanel Orientation="Horizontal" Margin="0,2">
            <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Preview_Layout}" />
            <RadioButton VerticalContentAlignment="Center" Padding="8,0,0,0" MinWidth="0" x:Name="SideBySideRadio" Content="{DynamicResource Preview_SideBySide}" GroupName="Layout" IsChecked="True" Checked="OnLayoutChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
            <RadioButton VerticalContentAlignment="Center" Padding="8,0,0,0" MinWidth="0" x:Name="StackedRadio" Content="{DynamicResource Preview_Stacked}" GroupName="Layout" Checked="OnLayoutChanged" VerticalAlignment="Center" />
          </StackPanel>
          <Rectangle Style="{StaticResource GroupLine}" />
          <StackPanel Orientation="Horizontal" Margin="0,2">
            <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Preview_Show}" />
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" x:Name="ShowImageBox" Content="{DynamicResource Preview_PaneImage}" IsChecked="True" Checked="OnLayoutChanged" Unchecked="OnLayoutChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" x:Name="ShowTextBox" Content="{DynamicResource Preview_PaneText}" IsChecked="True" Checked="OnLayoutChanged" Unchecked="OnLayoutChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" x:Name="ShowVlmBox" Content="{DynamicResource Preview_PaneVlm}" IsChecked="True" Checked="OnLayoutChanged" Unchecked="OnLayoutChanged" VerticalAlignment="Center" />
          </StackPanel>
          <Rectangle Style="{StaticResource GroupLine}" />
          <StackPanel Orientation="Horizontal" Margin="0,2">
            <TextBlock Style="{StaticResource GroupLabel}" Text="{DynamicResource Preview_GroupMarkdown}" />
            <RadioButton VerticalContentAlignment="Center" Padding="8,0,0,0" MinWidth="0" x:Name="RenderedRadio" Content="{DynamicResource Preview_Rendered}" GroupName="View" IsChecked="True" Checked="OnViewChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
            <RadioButton VerticalContentAlignment="Center" Padding="8,0,0,0" MinWidth="0" x:Name="TextRadio" Content="{DynamicResource Preview_Text}" GroupName="View" Checked="OnViewChanged" VerticalAlignment="Center" />
          </StackPanel>
        </WrapPanel>
      </Border>

      <!-- The panes are placed by code: side by side or stacked, only those that are chosen (slots 0, 2, 4; the splitters are slots 1 and 3) -->
      <Grid x:Name="PaneGrid" Grid.Row="1">
        <!-- The image of the page -->
        <Grid x:Name="ImagePane">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource Preview_PaneImage}" FontWeight="SemiBold" Margin="2,0,0,3" />
          <Grid Grid.Row="1">
            <ScrollViewer x:Name="ImageScroll" ToolTip="{DynamicResource Preview_ImageZoomTip}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" SizeChanged="OnImageScrollSizeChanged">
              <Image x:Name="PageImage" VerticalAlignment="Top" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </ScrollViewer>
            <TextBlock x:Name="NoImageText" Text="{DynamicResource Preview_NoImage}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0.6" />
          </Grid>
        </Grid>
        <local:MarkdownPane x:Name="TextPane" />
        <local:MarkdownPane x:Name="VlmPane" />
        <GridSplitter x:Name="Split0" ResizeBehavior="PreviousAndNext" />
        <GridSplitter x:Name="Split1" ResizeBehavior="PreviousAndNext" />
      </Grid>
    </Grid>
  </Grid>
</Window>
