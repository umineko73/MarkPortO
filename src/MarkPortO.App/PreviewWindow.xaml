<Window x:Class="MarkPortO.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarkPortO.App"
        Icon="Assets/MarkPortO.ico" Height="780" Width="1100" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner" KeyDown="OnKeyDown" PreviewKeyDown="OnPreviewKeyDown" PreviewMouseWheel="OnWheel">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210" MinWidth="120" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- The pages -->
    <ListBox x:Name="PageList" Grid.Column="0" DisplayMemberPath="Title" SelectionChanged="OnPageChanged" />
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <WrapPanel Grid.Row="0" Margin="0,0,0,6">
        <GroupBox Header="{DynamicResource Preview_GroupAction}" Margin="0,0,8,4" Padding="4,2">
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="FollowBox" Content="{DynamicResource Preview_Follow}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Content="{DynamicResource Preview_Refresh}" Click="OnRefresh" Padding="10,1" />
          </StackPanel>
        </GroupBox>
        <GroupBox Header="{DynamicResource Preview_Layout}" Margin="0,0,8,4" Padding="4,2">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="SideBySideRadio" Content="{DynamicResource Preview_SideBySide}" GroupName="Layout" IsChecked="True" Checked="OnLayoutChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
            <RadioButton x:Name="StackedRadio" Content="{DynamicResource Preview_Stacked}" GroupName="Layout" Checked="OnLayoutChanged" VerticalAlignment="Center" />
          </StackPanel>
        </GroupBox>
        <GroupBox Header="{DynamicResource Preview_GroupImage}" Margin="0,0,8,4" Padding="4,2">
          <CheckBox x:Name="FitBox" Content="{DynamicResource Preview_FitImage}" IsChecked="True" Checked="OnFitChanged" Unchecked="OnFitChanged" VerticalAlignment="Center" />
        </GroupBox>
        <GroupBox Header="{DynamicResource Preview_Show}" Margin="0,0,8,4" Padding="4,2">
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="ShowImageBox" Content="{DynamicResource Preview_PaneImage}" IsChecked="True" Checked="OnLayoutChanged" Unchecked="OnLayoutChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
            <CheckBox x:Name="ShowTextBox" Content="{DynamicResource Preview_PaneText}" IsChecked="True" Checked="OnLayoutChanged" Unchecked="OnLayoutChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
            <CheckBox x:Name="ShowVlmBox" Content="{DynamicResource Preview_PaneVlm}" IsChecked="True" Checked="OnLayoutChanged" Unchecked="OnLayoutChanged" VerticalAlignment="Center" />
          </StackPanel>
        </GroupBox>
        <GroupBox Header="{DynamicResource Preview_GroupMarkdown}" Margin="0,0,0,4" Padding="4,2">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RenderedRadio" Content="{DynamicResource Preview_Rendered}" GroupName="View" IsChecked="True" Checked="OnViewChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
            <RadioButton x:Name="TextRadio" Content="{DynamicResource Preview_Text}" GroupName="View" Checked="OnViewChanged" VerticalAlignment="Center" />
          </StackPanel>
        </GroupBox>
      </WrapPanel>

      <!-- The panes are placed by code: side by side or stacked, only those that are chosen (slots 0, 2, 4; the splitters are slots 1 and 3) -->
      <Grid x:Name="PaneGrid" Grid.Row="1">
        <!-- The image of the page -->
        <Grid x:Name="ImagePane">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="{DynamicResource Preview_PaneImage}" FontWeight="SemiBold" Margin="2,0,0,3" />
          <Grid Grid.Row="1">
            <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
              <Image x:Name="PageImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </ScrollViewer>
            <TextBlock x:Name="NoImageText" Text="{DynamicResource Preview_NoImage}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0.6" />
          </Grid>
        </Grid>
        <local:MarkdownPane x:Name="TextPane" />
        <local:MarkdownPane x:Name="VlmPane" />
        <GridSplitter x:Name="Split0" ResizeBehavior="PreviousAndNext" />
        <GridSplitter x:Name="Split1" ResizeBehavior="PreviousAndNext" />
      </Grid>
    </Grid>
  </Grid>
</Window>
