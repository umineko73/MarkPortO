<Window x:Class="MarkPortO.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/MarkPortO.ico" Title="{DynamicResource About_Title}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="MarkPortO" FontWeight="SemiBold" />
      <TextBlock Margin="8,0,0,0" x:Name="VersionText" />
    </StackPanel>
    <TextBlock Grid.Row="1" Margin="0,0,0,6" x:Name="AuthorText" />
    <TextBlock Grid.Row="2" Margin="0,0,0,6" x:Name="LicenseText" />
    <TextBlock Grid.Row="3" Margin="0,0,0,6">
      <Hyperlink Click="OnLinkClick"><Run x:Name="LinkText" /></Hyperlink>
    </TextBlock>
    <Button Grid.Row="4" HorizontalAlignment="Right" Margin="0,10,0,0" MinWidth="80" IsDefault="True" IsCancel="True" Content="{DynamicResource About_Close}" Click="OnOkClick" />
  </Grid>
</Window>
