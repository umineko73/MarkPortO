<Window x:Class="MarkPortO.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/MarkPortO.ico" Title="MarkPortO" Height="1000" Width="1360" MinHeight="640" MinWidth="780">
  <Grid>
  <DockPanel IsEnabled="{Binding CanUse}">
    <!-- Menu bar (FR-032) -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{DynamicResource Menu_File}">
        <MenuItem Header="{DynamicResource Menu_OutputHistory}" Click="OnOutputHistoryClick"><MenuItem.Icon><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" /></MenuItem.Icon></MenuItem>
        <Separator />
        <MenuItem Header="{DynamicResource Menu_WorkSetSave}" Click="OnSaveWorkSetClick"><MenuItem.Icon><TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" /></MenuItem.Icon></MenuItem>
        <MenuItem x:Name="WorkSetsMenu" Header="{DynamicResource Menu_WorkSetOpen}" SubmenuOpened="OnWorkSetsMenuOpened" IsEnabled="{Binding CanEdit}"><MenuItem.Icon><TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" /></MenuItem.Icon>
          <MenuItem Header="{DynamicResource Menu_WorkSetNone}" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="{DynamicResource Menu_WorkSetManage}" Click="OnManageWorkSetsClick"><MenuItem.Icon><TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" /></MenuItem.Icon></MenuItem>
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu_Settings}">
        <MenuItem Header="{DynamicResource Menu_Language}"><MenuItem.Icon><TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" /></MenuItem.Icon>
          <MenuItem Header="{DynamicResource Menu_Lang_System}" Tag="system" Click="OnLanguageClick" IsCheckable="True" IsChecked="{Binding LanguageIsSystem, Mode=OneWay}" />
          <MenuItem Header="{DynamicResource Menu_Lang_Ja}" Tag="ja" Click="OnLanguageClick" IsCheckable="True" IsChecked="{Binding LanguageIsJapanese, Mode=OneWay}" />
          <MenuItem Header="{DynamicResource Menu_Lang_En}" Tag="en" Click="OnLanguageClick" IsCheckable="True" IsChecked="{Binding LanguageIsEnglish, Mode=OneWay}" />
        </MenuItem>
        <MenuItem Header="{DynamicResource Menu_Theme}"><MenuItem.Icon><TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" /></MenuItem.Icon>
          <MenuItem Header="{DynamicResource Menu_Theme_System}" Tag="system" Click="OnThemeClick" IsCheckable="True" IsChecked="{Binding ThemeIsSystem, Mode=OneWay}" />
          <MenuItem Header="{DynamicResource Menu_Theme_Light}" Tag="light" Click="OnThemeClick" IsCheckable="True" IsChecked="{Binding ThemeIsLight, Mode=OneWay}" />
          <MenuItem Header="{DynamicResource Menu_Theme_Dark}" Tag="dark" Click="OnThemeClick" IsCheckable="True" IsChecked="{Binding ThemeIsDark, Mode=OneWay}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{DynamicResource Menu_VlmSettings}" Command="{Binding ConnectionSettingsCommand}"><MenuItem.Icon><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" /></MenuItem.Icon></MenuItem>
        <MenuItem Header="{DynamicResource Menu_Prompts}" Command="{Binding PromptsCommand}"><MenuItem.Icon><TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" /></MenuItem.Icon></MenuItem>
        <MenuItem Header="{DynamicResource Menu_ExtractorSettings}" Command="{Binding ExtractorSettingsCommand}"><MenuItem.Icon><TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" /></MenuItem.Icon></MenuItem>
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu_Help}">
        <MenuItem Header="{DynamicResource Menu_About}" Click="OnAboutClick"><MenuItem.Icon><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" /></MenuItem.Icon></MenuItem>
        <MenuItem Header="{DynamicResource Menu_Licenses}" Click="OnLicensesClick"><MenuItem.Icon><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" /></MenuItem.Icon></MenuItem>
      </MenuItem>
    </Menu>

    <Grid Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Inputs -->
      <GroupBox Grid.Row="0" Header="{DynamicResource Main_Inputs}" Padding="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ListBox Grid.Column="0" ItemsSource="{Binding InputPaths}" MinHeight="84" SelectionMode="Extended" SelectionChanged="OnInputSelectionChanged"
                   AllowDrop="True" DragOver="OnDragOver" Drop="OnDropInputs" IsEnabled="{Binding CanEdit}">
            <ListBox.InputBindings>
              <KeyBinding Key="Delete" Command="{Binding RemoveSelectedInputsCommand}" />
            </ListBox.InputBindings>
          </ListBox>
          <StackPanel Grid.Column="1" Margin="8,0,0,0" Width="150">
            <Button Content="{DynamicResource Main_AddFiles}" Command="{Binding AddFilesCommand}" Margin="0,0,0,4" Padding="4" />
            <Button Content="{DynamicResource Main_AddFolder}" Command="{Binding AddFolderCommand}" Margin="0,0,0,4" Padding="4" />
            <Button Content="{DynamicResource Main_RemoveSelected}" Command="{Binding RemoveSelectedInputsCommand}" Margin="0,0,0,4" Padding="4" />
            <Button Content="{DynamicResource Main_ClearInputs}" Command="{Binding ClearInputsCommand}" Padding="4" />
          </StackPanel>
        </Grid>
      </GroupBox>

      <!-- Output folder -->
      <GroupBox Grid.Row="1" Header="{DynamicResource Main_Output}" Padding="6" Margin="0,6,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding OutputFolder, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center"
                   AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDropOutput" IsEnabled="{Binding CanEdit}" />
          <Button Grid.Column="1" Content="{DynamicResource Main_Browse}" Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" Padding="12,4" />
        </Grid>
      </GroupBox>

      <!-- Conditions: one row for each kind of setting -->
      <GroupBox Grid.Row="2" Header="{DynamicResource Main_Conditions}" Padding="6" Margin="0,6,0,0">
        <GroupBox.Resources>
          <!-- A small button with a symbol of Segoe Fluent Icons (Segoe MDL2 Assets on Windows 10); its name is in the tooltip. -->
          <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
          </Style>
          <!-- A text has no disabled look of its own: the labels of a locked item are shown dimmed too (FR-066). -->
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </GroupBox.Resources>
        <StackPanel>
          <!-- The preset of the conversion (FR-151): choosing one puts its values into the steps; they can still be changed -->
          <DockPanel Margin="0,0,0,6" IsEnabled="{Binding CanEdit}">
            <TextBlock Text="{DynamicResource Main_Preset}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox ItemsSource="{Binding PresetItems}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedPreset}" MinWidth="220" VerticalAlignment="Center"
                      ToolTip="{DynamicResource Main_PresetTip}" />
            <TextBlock Text="{Binding PresetStateText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
            <Button Content="{DynamicResource Main_PresetSave}" Click="OnSavePresetClick" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center"
                    ToolTip="{DynamicResource Main_PresetSaveTip}" />
            <Button Content="{DynamicResource Main_PresetManage}" Click="OnManagePresetsClick" Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
          </DockPanel>

          <!-- The folded part: the kinds of file and the conversion (FR-102). Closed, the line says what is chosen. Steps are always shown. -->
          <Expander x:Name="ConditionsExpander" IsExpanded="{Binding ConditionsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Margin="0,0,0,6"
                    ToolTip="{DynamicResource Main_Cond_FoldTip}">
            <Expander.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Main_Cond_Fold}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ConditionSummaryText, Mode=OneWay}" ToolTip="{Binding ConditionSummaryText, Mode=OneWay}"
                           Visibility="{Binding ConditionsCollapsedVisibility}" Margin="14,0,8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubtleTextBrush}" />
              </Grid>
            </Expander.Header>

          <!-- The folded part itself: the Expander shows it when it is open. -->
          <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- The kinds of file that are converted when a folder is given -->
          <TextBlock Grid.Row="0" Text="{DynamicResource Main_Cond_Targets}" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding CanEditNewRun}" />
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding CanEditNewRun}">
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" x:Name="DocxBox" Content="docx" IsChecked="{Binding TypeDocx}" ToolTip="{DynamicResource Main_Cond_TypesNote}" VerticalAlignment="Center" Margin="0,0,20,0" />
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="xlsx" IsChecked="{Binding TypeXlsx}" ToolTip="{DynamicResource Main_Cond_TypesNote}" VerticalAlignment="Center" Margin="0,0,20,0" />
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="pptx" IsChecked="{Binding TypePptx}" ToolTip="{DynamicResource Main_Cond_TypesNote}" VerticalAlignment="Center" Margin="0,0,20,0" />
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="pdf" IsChecked="{Binding TypePdf}" ToolTip="{DynamicResource Main_Cond_TypesNote}" VerticalAlignment="Center" Margin="0,0,40,0" />
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_Recurse}" IsChecked="{Binding Recurse}" VerticalAlignment="Center" />
            <!-- Where the output of a folder goes (FR-154) -->
            <TextBlock Text="{DynamicResource Main_Cond_FolderLayout}" ToolTip="{DynamicResource Main_Cond_FolderLayoutTip}" VerticalAlignment="Center" Margin="24,0,8,0" />
            <ComboBox SelectedIndex="{Binding FolderLayoutIndex}" ToolTip="{DynamicResource Main_Cond_FolderLayoutTip}" VerticalAlignment="Center" MinWidth="150">
              <ComboBoxItem Content="{DynamicResource Main_Cond_FolderLayoutFolder}" />
              <ComboBoxItem Content="{DynamicResource Main_Cond_FolderLayoutContents}" />
            </ComboBox>
          </StackPanel>

          <!-- Who extracts the text of each kind . Shown when an extractor is registered. -->
          <TextBlock Grid.Row="1" Text="{DynamicResource Main_Cond_Extractor}" VerticalAlignment="Center" Margin="0,0,0,6" ToolTip="{DynamicResource Main_Cond_ExtractorTip}"
                     Visibility="{Binding ExtractorVisibility}" IsEnabled="{Binding CanEditNewRun}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding ExtractorVisibility}"
                      IsEnabled="{Binding CanEditNewRun}">
            <TextBlock Text="{DynamicResource Main_Cond_RowDocx}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding ExtractorChoices}" DisplayMemberPath="Display" SelectedValuePath="Name" SelectedValue="{Binding ExtractorDocx}" Width="120" Margin="0,0,16,0" />
            <TextBlock Text="{DynamicResource Main_Cond_RowXlsx}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding ExtractorChoices}" DisplayMemberPath="Display" SelectedValuePath="Name" SelectedValue="{Binding ExtractorXlsx}" Width="120" Margin="0,0,16,0" />
            <TextBlock Text="{DynamicResource Main_Cond_RowPptx}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding ExtractorChoices}" DisplayMemberPath="Display" SelectedValuePath="Name" SelectedValue="{Binding ExtractorPptx}" Width="120" Margin="0,0,16,0" />
            <TextBlock Text="{DynamicResource Main_Cond_RowPdf}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding ExtractorChoices}" DisplayMemberPath="Display" SelectedValuePath="Name" SelectedValue="{Binding ExtractorPdf}" Width="120" />
          </StackPanel>

          <!-- The options of each kind. Always shown (a file that is given is converted whatever the boxes say); grey when an extractor is chosen.
               Word has none, so it has no row. -->
          <TextBlock Grid.Row="2" Text="{DynamicResource Main_Cond_OptionsRow}" VerticalAlignment="Top" Margin="0,2,0,6" IsEnabled="{Binding CanEditNewRun}" />
          <Grid Grid.Row="2" Grid.Column="1" IsEnabled="{Binding CanEditNewRun}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Main_Cond_RowXlsx}" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding XlsxOptionsEnabled}" />
            <!-- A wrap panel: with the choice of a file for each sheet (FR-153) the row can be wider than the window; it goes on in a second line then. -->
            <WrapPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding XlsxOptionsEnabled}" ToolTip="{Binding XlsxOptionsTip}" ToolTipService.ShowOnDisabled="True">
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_HiddenSheets}" IsChecked="{Binding IncludeHiddenSheets}" VerticalAlignment="Center" Margin="0,0,20,0" />
              <TextBlock Text="{DynamicResource Main_Cond_Excel}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <RadioButton VerticalContentAlignment="Center" Padding="8,0,0,0" GroupName="ExcelRange" Content="{DynamicResource Main_Cond_ExcelColumns}" IsChecked="{Binding ExcelColumns}" ToolTip="{DynamicResource Main_Cond_ExcelColumnsTip}" VerticalAlignment="Center" Margin="0,0,16,0" />
              <RadioButton VerticalContentAlignment="Center" Padding="8,0,0,0" GroupName="ExcelRange" Content="{DynamicResource Main_Cond_ExcelSheet}" IsChecked="{Binding ExcelSheet}" ToolTip="{DynamicResource Main_Cond_ExcelSheetTip}" VerticalAlignment="Center" Margin="0,0,16,0" />
              <RadioButton VerticalContentAlignment="Center" Padding="8,0,0,0" GroupName="ExcelRange" Content="{DynamicResource Main_Cond_ExcelPrintArea}" IsChecked="{Binding ExcelPrintArea}" ToolTip="{DynamicResource Main_Cond_ExcelPrintAreaTip}" VerticalAlignment="Center" Margin="0,0,24,0" />
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_ExcelPerSheet}" ToolTip="{DynamicResource Main_Cond_ExcelPerSheetTip}" IsChecked="{Binding ExcelPerSheet}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" />
            </WrapPanel>

            <TextBlock Grid.Row="1" Text="{DynamicResource Main_Cond_RowPptx}" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding PptxOptionsEnabled}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding PptxOptionsEnabled}" ToolTip="{Binding PptxOptionsTip}" ToolTipService.ShowOnDisabled="True">
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_HiddenSlides}" IsChecked="{Binding IncludeHiddenSlides}" VerticalAlignment="Center" Margin="0,0,20,0" />
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_OffSlide}" IsChecked="{Binding IncludeOffSlideText}" ToolTip="{DynamicResource Main_Cond_OffSlideTip}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{DynamicResource Main_Cond_RowPdf}" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding PdfOptionsEnabled}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding PdfOptionsEnabled}" ToolTip="{Binding PdfOptionsTip}" ToolTipService.ShowOnDisabled="True">
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_PdfText}" IsChecked="{Binding UsePdfText}" ToolTip="{DynamicResource Main_Cond_PdfTextTip}" VerticalAlignment="Center" Margin="0,0,20,0" />
              <TextBlock Text="{DynamicResource Main_Cond_PdfHint}" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Visibility="{Binding PdfHintVisibility}" />
            </StackPanel>
          </Grid>

          <!-- The details of the steps: set once, so they are folded with the rest; the summary of the header says the ones that are not the usual ones. -->
          <TextBlock Grid.Row="3" Text="{DynamicResource Main_Cond_Details}" VerticalAlignment="Top" Margin="0,8,0,0" />
          <Grid Grid.Row="3" Grid.Column="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Step1" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding CanEditNewRun}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding CanEditNewRun}">
              <TextBlock Text="{DynamicResource Main_Cond_Engine}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox x:Name="EngineBox" ItemsSource="{Binding EngineChoices}" DisplayMemberPath="Name" SelectedValuePath="Kind"
                        SelectedValue="{Binding SelectedEngine}" Width="170" Margin="0,0,20,0" />
              <TextBlock Text="{DynamicResource Main_Cond_Dpi}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox x:Name="DpiBox" Text="{Binding DpiText, UpdateSourceTrigger=LostFocus}" Width="68" VerticalContentAlignment="Center" Margin="0,0,20,0" />
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_Emphasis}" IsChecked="{Binding Emphasis}" ToolTip="{DynamicResource Main_Cond_EmphasisTip}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Step2" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding CanEditPageImage}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="{DynamicResource Main_Cond_PageImage}" VerticalAlignment="Center" Margin="0,0,6,0" IsEnabled="{Binding CanEditPageImage}" />
              <ComboBox SelectedIndex="{Binding PageImageIndex}" IsEnabled="{Binding CanEditPageImage}" VerticalAlignment="Center" MinWidth="200" ToolTip="{DynamicResource Main_Cond_PageImageTip}">
                <ComboBoxItem Content="{DynamicResource Main_Cond_PageImageImage}" />
                <ComboBoxItem Content="{DynamicResource Main_Cond_PageImageReference}" />
                <ComboBoxItem Content="{DynamicResource Main_Cond_PageImageLink}" />
              </ComboBox>
            </StackPanel>

            <!-- Step3: where its results go, then what is done with the tables of the pages that the VLM read whole. Both only when Step3 is on. -->
            <TextBlock Grid.Row="2" Text="Step3" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding CanEditVlmSeparate}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding CanEditVlmSeparate}">
              <TextBlock Text="{DynamicResource Main_Cond_VlmOutput}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox SelectedIndex="{Binding VlmSeparateIndex}" ToolTip="{DynamicResource Main_Cond_VlmOutputTip}" VerticalAlignment="Center" MinWidth="250">
                <ComboBoxItem Content="{DynamicResource Main_Cond_VlmOutputInline}" />
                <ComboBoxItem Content="{DynamicResource Main_Cond_VlmOutputSeparate}" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding CanEditStep1Tables}">
              <TextBlock Text="{DynamicResource Main_Cond_WholeTables}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{DynamicResource Main_Cond_TablesTip}" />
              <ComboBox SelectedIndex="{Binding Step1TablesIndex}" ToolTip="{DynamicResource Main_Cond_TablesTip}" VerticalAlignment="Center" Margin="0,0,20,0" MinWidth="170">
                <ComboBoxItem Content="{DynamicResource Main_Cond_TablesVlm}" />
                <ComboBoxItem Content="{DynamicResource Main_Cond_TablesReplace}" />
                <ComboBoxItem Content="{DynamicResource Main_Cond_TablesOmit}" />
              </ComboBox>
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_DropRepeated}" ToolTip="{DynamicResource Main_Cond_DropRepeatedTip}" IsChecked="{Binding DropRepeatedTables}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- The Markdown itself (FR-151): it does not depend on the steps. -->
            <TextBlock Grid.Row="4" Text="{DynamicResource Preview_GroupMarkdown}" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding CanEdit}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding CanEdit}">
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_StructureNote}" ToolTip="{DynamicResource Main_Cond_StructureNoteTip}" IsChecked="{Binding StructureNote}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Files written besides the Markdown (FR-152): on their own. -->
            <TextBlock Grid.Row="5" Text="{DynamicResource Main_Cond_ExtraOutput}" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding CanEdit}">
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_Chunks}" ToolTip="{DynamicResource Main_Cond_ChunksTip}" IsChecked="{Binding Chunks}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          </Grid>
          </Expander>

          <!-- Steps: always shown, also when the part above is folded (FR-102). Only what is chosen for a run is here; the details are folded. -->
          <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Step1 always runs: it is shown, and it cannot be changed (FR-039) -->
          <TextBlock Grid.Row="0" Text="Step1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,6" />
          <WrapPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource Main_Cond_Step1}" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource SubtleTextBrush}" />
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditNewRun}">
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_Pictures}" IsChecked="{Binding ExtractPictures}" ToolTip="{DynamicResource Main_Cond_PicturesTip}" VerticalAlignment="Center" Margin="0,0,20,0" />
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_Shapes}" IsChecked="{Binding ExtractShapes}" ToolTip="{DynamicResource Main_Cond_ShapesTip}" VerticalAlignment="Center" Margin="0,0,20,0" />
              <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_GroupShapes}" IsChecked="{Binding GroupNearShapes}" IsEnabled="{Binding ExtractShapes}" ToolTip="{DynamicResource Main_Cond_GroupShapesTip}" VerticalAlignment="Center" />
            </StackPanel>
          </WrapPanel>

          <TextBlock Grid.Row="1" Text="Step2" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,6" />
          <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_Step2}" IsChecked="{Binding Step2}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" />
          </WrapPanel>

          <!-- Step3: what a run chooses (on or off, how the VLM is used, the connection, the prompts, the pages) -->
          <TextBlock Grid.Row="2" Text="Step3" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,6" />
          <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
            <CheckBox VerticalContentAlignment="Center" Padding="8,0,0,0" Content="{DynamicResource Main_Cond_Step3}" IsChecked="{Binding Step3}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="0,0,20,0" />
            <!-- How Step3 uses the VLM (FR-150) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" Visibility="{Binding Step3DetailsVisibility}">
              <TextBlock Text="{DynamicResource Main_Cond_Step3Mode}" VerticalAlignment="Center" Margin="0,0,6,0" IsEnabled="{Binding CanEditStep1Tables}" />
              <ComboBox SelectedIndex="{Binding Step3ModeIndex}" IsEnabled="{Binding CanEditStep1Tables}" ToolTip="{DynamicResource Main_Cond_Step3ModeTip}" VerticalAlignment="Center" MinWidth="130">
                <ComboBoxItem Content="{DynamicResource Main_Cond_Step3ModeSupplement}" />
                <ComboBoxItem Content="{DynamicResource Main_Cond_Step3ModeTranscribe}" />
              </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" Visibility="{Binding Step3DetailsVisibility}">
              <TextBlock Text="{DynamicResource Main_Cond_Connection}" VerticalAlignment="Center" Margin="0,0,6,0" IsEnabled="{Binding CanEdit}" />
              <ComboBox ItemsSource="{Binding ConnectionItems}" SelectedIndex="{Binding ConnectionIndex}" IsEnabled="{Binding CanEdit}" MinWidth="190" VerticalAlignment="Center" />
              <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding ConnectionSettingsCommand}" Margin="4,0,0,0"
                      ToolTip="{DynamicResource Menu_VlmSettings}" AutomationProperties.Name="{DynamicResource Menu_VlmSettings}" />
            </StackPanel>
            <!-- The pages that Step3 reads: for one file only (FR-097) -->
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditPages}" ToolTip="{Binding PagesTip}" ToolTipService.ShowOnDisabled="True" Visibility="{Binding PagesVisibility}">
              <TextBlock Text="{DynamicResource Main_Cond_Pages}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding PageRangeText, UpdateSourceTrigger=PropertyChanged}" Width="110" VerticalContentAlignment="Center" />
            </StackPanel>
          </WrapPanel>

          <!-- The prompt of each kind of file that Step3 sends to the VLM (FR-115) -->
          <WrapPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Visibility="{Binding Step3DetailsVisibility}">
            <TextBlock Text="{DynamicResource Main_Cond_Prompt}" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="{Binding CanEditPrompts}" />
            <ItemsControl ItemsSource="{Binding PromptChoices}" IsEnabled="{Binding CanEditPrompts}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex}" MinWidth="140" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Command="{Binding PromptsCommand}"
                    ToolTip="{DynamicResource Menu_Prompts}" AutomationProperties.Name="{DynamicResource Menu_Prompts}" />
          </WrapPanel>

          </Grid>
        </StackPanel>
      </GroupBox>

      <!-- Actions -->
      <!-- Three groups, each in a frame: the conversion, where a file converted before is written, and the file chosen in the list. -->
      <DockPanel Grid.Row="3" Margin="0,10,0,10" LastChildFill="False">
        <DockPanel.Resources>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <!-- A button with a symbol before its text: the symbol (Segoe Fluent Icons) is in Tag. -->
          <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ContentTemplate">
              <Setter.Value>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <!-- The main buttons ("Start", "Resume") in the accent colour of Windows, so that the next step is seen at a glance. -->
          <Style x:Key="PrimaryGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
          </Style>
          <Style x:Key="ActionGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,4" />
          </Style>
        </DockPanel.Resources>
        <!-- The conversion (FR-129): one main button that does what the list calls for and says how many files it takes; the other ways are in its menu.
             "Interrupt" stays a button of its own, so that a double click on the main button never stops what it has just started. -->
        <Border DockPanel.Dock="Left" Style="{StaticResource ActionGroup}">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="MainRunButton" Style="{StaticResource PrimaryGlyphButton}" Tag="&#xE768;" Content="{Binding MainRunText}" Command="{Binding MainRunCommand}" MinWidth="120" Padding="12,6" FontWeight="SemiBold"
                    ToolTip="{Binding MainRunTip}" ToolTipService.ShowOnDisabled="True" />
            <!-- With its name, so that it is seen to open the other ways also when the main button cannot be pressed. -->
            <Button x:Name="MoreRunButton" Click="OnMoreRunClick" Padding="10,6" Margin="4,0,16,0" IsEnabled="{Binding CanEdit}"
                    ToolTip="{DynamicResource Main_MoreTip}" ToolTipService.ShowOnDisabled="True">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Main_More}" VerticalAlignment="Center" />
                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="6,1,0,0" />
              </StackPanel>
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{DynamicResource Main_Start}" Command="{Binding StartCommand}" ToolTip="{DynamicResource Main_StartTip}" ToolTipService.ShowOnDisabled="True" />
                  <MenuItem Header="{DynamicResource Main_Resume}" Command="{Binding ResumeCommand}" ToolTip="{DynamicResource Main_ResumeTip}" ToolTipService.ShowOnDisabled="True" />
                  <Separator />
                  <MenuItem Header="{DynamicResource Main_RedoAll}" Command="{Binding RedoAllCommand}" ToolTip="{DynamicResource Main_RedoAllTip}" ToolTipService.ShowOnDisabled="True" />
                  <MenuItem Header="{Binding ChangedMenuText}" Command="{Binding StartChangedCommand}" ToolTip="{DynamicResource Main_ChangedOnlyTip}" ToolTipService.ShowOnDisabled="True" />
                  <Separator />
                  <MenuItem Header="{Binding RereadMenuText}" Command="{Binding RereadCommand}" ToolTip="{DynamicResource Main_RereadTip}" ToolTipService.ShowOnDisabled="True" />
                  <MenuItem Header="{DynamicResource Main_Reconvert}" Click="OnReconvertClick" IsEnabled="{Binding CanReconvertSelected}"
                            ToolTip="{DynamicResource Main_ReconvertTip}" ToolTipService.ShowOnDisabled="True" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button Style="{StaticResource GlyphButton}" Tag="&#xE71A;" Content="{DynamicResource Main_Interrupt}" Command="{Binding InterruptCommand}" MinWidth="90" Padding="12,6" />
          </StackPanel>
        </Border>
        <!-- FR-129: what "Start" and "Redo all" do with a file that was converted before. -->
        <Border DockPanel.Dock="Left" Style="{StaticResource ActionGroup}" Margin="10,0,0,0"
                ToolTip="{DynamicResource Main_ExistingTip}" ToolTipService.ShowOnDisabled="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}">
            <TextBlock Text="{DynamicResource Main_Existing}" VerticalAlignment="Center" Margin="2,0,8,0" />
            <ComboBox SelectedIndex="{Binding SameFolderIndex}" MinWidth="130" VerticalAlignment="Center">
              <ComboBoxItem Content="{DynamicResource Main_ExistingNew}" />
              <ComboBoxItem Content="{DynamicResource Main_ExistingSame}" />
            </ComboBox>
          </StackPanel>
        </Border>
        <!-- The file chosen in the list. "Run Step3 again" and "Convert again from Step1" are in the menu of the main button and of the list. -->
        <Border DockPanel.Dock="Right" Style="{StaticResource ActionGroup}" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="PreviewButton" Content="{DynamicResource Main_Preview}" Click="OnPreviewClick" MinWidth="90" Padding="6"
                    IsEnabled="{Binding Selected.CanPreview, FallbackValue=False, TargetNullValue=False}"
                    ToolTip="{DynamicResource Main_PreviewTip}" ToolTipService.ShowOnDisabled="True" />
          </StackPanel>
        </Border>
      </DockPanel>

      <Grid Grid.Row="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="90" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="90" />
        </Grid.RowDefinitions>
        <!-- File list -->
        <DataGrid x:Name="FileGrid" Grid.Row="0" ItemsSource="{Binding Files}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" MouseDoubleClick="OnFileDoubleClick" SelectionChanged="OnFileSelectionChanged"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{DynamicResource Main_Preview}" Click="OnPreviewClick" IsEnabled="{Binding Selected.CanPreview, FallbackValue=False, TargetNullValue=False}" />
              <Separator />
              <MenuItem Header="{DynamicResource Main_OpenFolder}" Click="OnOpenFolderClick" IsEnabled="{Binding Selected.HasOutputFolder, FallbackValue=False, TargetNullValue=False}" />
              <MenuItem Header="{DynamicResource Main_OpenMarkdown}" Click="OnOpenMarkdownClick" IsEnabled="{Binding Selected.HasMarkdown, FallbackValue=False, TargetNullValue=False}" />
              <MenuItem Header="{DynamicResource Main_OpenVlm}" Click="OnOpenVlmClick" IsEnabled="{Binding Selected.HasVlm, FallbackValue=False, TargetNullValue=False}" />
              <Separator />
              <MenuItem Header="{DynamicResource Main_Reconvert}" Click="OnReconvertClick" ToolTip="{DynamicResource Main_ReconvertTip}"
                        IsEnabled="{Binding CanEdit}" />
              <Separator />
              <MenuItem Header="{DynamicResource Main_RereadMark}" Click="OnRereadMarkClick" ToolTip="{DynamicResource Main_RereadMarkTip}"
                        IsEnabled="{Binding CanMarkSelectedForReread}" />
              <MenuItem Header="{DynamicResource Main_RereadUnmark}" Click="OnRereadUnmarkClick" IsEnabled="{Binding CanMarkSelectedForReread}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource FailedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPageFailures}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource PartlyFailedBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding FileName}" Width="3*">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_File}" />
              </DataGridTextColumn.Header>
              <DataGridTextColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Setter Property="ToolTip" Value="{Binding FullPath}" />
                </Style>
              </DataGridTextColumn.CellStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding KindText}" Width="68">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_Type}" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <!-- The state with a coloured mark: green done, orange some pages failed, red failed, accent running, grey waiting or interrupted -->
            <DataGridTemplateColumn Width="150" SortMemberPath="StateText">
              <DataGridTemplateColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_State}" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="2,0,7,0" VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource SubtleTextBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding StateKind}" Value="done">
                              <Setter Property="Fill" Value="{DynamicResource SucceededBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StateKind}" Value="partly">
                              <Setter Property="Fill" Value="{DynamicResource PartlyFailedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StateKind}" Value="failed">
                              <Setter Property="Fill" Value="{DynamicResource FailedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StateKind}" Value="running">
                              <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Step1" Binding="{Binding Step1Text}" Width="80" />
            <DataGridTextColumn Header="Step2" Binding="{Binding Step2Text}" Width="80" />
            <!-- Step3 with a thin bar while it reads the pages -->
            <DataGridTemplateColumn Header="Step3" Width="110" SortMemberPath="Step3Text">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Step3Text}" />
                    <ProgressBar Height="3" MinHeight="3" Margin="0,1,6,0" Maximum="100" Value="{Binding Step3Percent, Mode=OneWay}">
                      <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsStep3Progress}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ProgressBar.Style>
                    </ProgressBar>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Binding="{Binding PageCount}" Width="64">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_Pages}" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding OutputText}" Width="140">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_Output}" />
              </DataGridTextColumn.Header>
              <DataGridTextColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Setter Property="ToolTip" Value="{Binding OutputFolderPath}" />
                </Style>
              </DataGridTextColumn.CellStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding UsageShort}" Width="150">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_Usage}" />
              </DataGridTextColumn.Header>
              <DataGridTextColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Setter Property="ToolTip">
                    <Setter.Value>
                      <ToolTip MaxWidth="600">
                        <TextBlock Text="{Binding UsageText}" TextWrapping="Wrap" />
                      </ToolTip>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding UsageText}" Value="">
                      <Setter Property="ToolTip" Value="{x:Null}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTextColumn.CellStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding Message}" Width="*">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_Message}" />
              </DataGridTextColumn.Header>
              <DataGridTextColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Setter Property="ToolTip">
                    <Setter.Value>
                      <ToolTip MaxWidth="600">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      </ToolTip>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Message}" Value="">
                      <Setter Property="ToolTip" Value="{x:Null}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTextColumn.CellStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- The two lists share the height: the splitter changes the size of each -->
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" Cursor="SizeNS" ToolTip="{DynamicResource Main_SplitterTip}" />

        <!-- The pages of the selected file -->
        <GroupBox Grid.Row="2" Header="{DynamicResource Main_PagesGroup}" Padding="4">
          <DataGrid x:Name="PageGrid" ItemsSource="{Binding Selected.Pages}" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{DynamicResource Main_Preview}" Click="OnPagePreviewClick">
                  <MenuItem.Style>
                    <Style TargetType="MenuItem">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="{x:Null}">
                          <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </MenuItem.Style>
                </MenuItem>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnPageRightClick" />
                <EventSetter Event="MouseDoubleClick" Handler="OnPageDoubleClick" />
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Binding="{Binding Index}" Width="80">
                <DataGridTextColumn.Header>
                  <TextBlock Text="{DynamicResource Main_Col_Page}" />
                </DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding Label}" Width="*">
                <DataGridTextColumn.Header>
                  <TextBlock Text="{DynamicResource Main_Col_Position}" />
                </DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding VlmState}" Width="120">
                <DataGridTextColumn.Header>
                  <TextBlock Text="{DynamicResource Main_Col_VlmState}" />
                </DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding UsageText}" Width="2*">
                <DataGridTextColumn.Header>
                  <TextBlock Text="{DynamicResource Main_Col_Usage}" />
                </DataGridTextColumn.Header>
                <DataGridTextColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="ToolTip" Value="{Binding UsageText}" />
                  </Style>
                </DataGridTextColumn.CellStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </GroupBox>
      </Grid>

      <!-- Status, with the progress of a run: the files finished of the files of the list -->
      <DockPanel Grid.Row="5" Margin="0,8,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding BusyVisibility}" Margin="12,0,0,0">
          <ProgressBar Width="70" Height="4" MinHeight="4" VerticalAlignment="Center" IsIndeterminate="True" />
          <TextBlock Text="{DynamicResource Status_Processing}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding ProgressVisibility}" Margin="12,0,0,0">
          <ProgressBar Width="200" Height="4" MinHeight="4" VerticalAlignment="Center" Maximum="{Binding Files.Count, Mode=OneWay}" Value="{Binding FinishedCount, Mode=OneWay}" />
          <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Grid>
  </DockPanel>

  <!-- While the screen waits before it can be used again (reading the files, checking the inputs): a message in the middle, and no clicks -->
  <Grid Visibility="{Binding WaitVisibility}" Background="{DynamicResource WaitShadeBrush}">
    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,20" CornerRadius="8" MinWidth="280"
            Background="{DynamicResource WaitCardBrush}" BorderBrush="{DynamicResource SubtleTextBrush}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="{Binding WaitMessage}" FontSize="15" HorizontalAlignment="Center" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" Margin="0,14,0,0" />
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
