<Window x:Class="MarkPortO.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/MarkPortO.ico" Title="MarkPortO" Height="1000" Width="1360" MinHeight="640" MinWidth="780">
  <DockPanel>
    <!-- Menu bar (FR-032) -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{DynamicResource Menu_File}">
        <MenuItem Header="{DynamicResource Menu_OpenPast}" Click="OnOpenPastClick" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu_Settings}">
        <MenuItem Header="{DynamicResource Menu_Language}">
          <MenuItem Header="{DynamicResource Menu_Lang_System}" Tag="system" Click="OnLanguageClick" IsCheckable="True" IsChecked="{Binding LanguageIsSystem, Mode=OneWay}" />
          <MenuItem Header="{DynamicResource Menu_Lang_Ja}" Tag="ja" Click="OnLanguageClick" IsCheckable="True" IsChecked="{Binding LanguageIsJapanese, Mode=OneWay}" />
          <MenuItem Header="{DynamicResource Menu_Lang_En}" Tag="en" Click="OnLanguageClick" IsCheckable="True" IsChecked="{Binding LanguageIsEnglish, Mode=OneWay}" />
        </MenuItem>
        <MenuItem Header="{DynamicResource Menu_Theme}">
          <MenuItem Header="{DynamicResource Menu_Theme_System}" Tag="system" Click="OnThemeClick" IsCheckable="True" IsChecked="{Binding ThemeIsSystem, Mode=OneWay}" />
          <MenuItem Header="{DynamicResource Menu_Theme_Light}" Tag="light" Click="OnThemeClick" IsCheckable="True" IsChecked="{Binding ThemeIsLight, Mode=OneWay}" />
          <MenuItem Header="{DynamicResource Menu_Theme_Dark}" Tag="dark" Click="OnThemeClick" IsCheckable="True" IsChecked="{Binding ThemeIsDark, Mode=OneWay}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{DynamicResource Menu_VlmSettings}" Command="{Binding ConnectionSettingsCommand}" />
        <MenuItem Header="{DynamicResource Menu_Prompts}" Command="{Binding PromptsCommand}" />
        <MenuItem Header="{DynamicResource Menu_ExtractorSettings}" Command="{Binding ExtractorSettingsCommand}" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Menu_Help}">
        <MenuItem Header="{DynamicResource Menu_About}" Click="OnAboutClick" />
        <MenuItem Header="{DynamicResource Menu_Licenses}" Click="OnLicensesClick" />
      </MenuItem>
    </Menu>

    <Grid Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Inputs -->
      <GroupBox Grid.Row="0" Header="{DynamicResource Main_Inputs}" Padding="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ListBox Grid.Column="0" ItemsSource="{Binding InputPaths}" MinHeight="84" SelectionMode="Extended" SelectionChanged="OnInputSelectionChanged"
                   AllowDrop="True" DragOver="OnDragOver" Drop="OnDropInputs" IsEnabled="{Binding CanEdit}">
            <ListBox.InputBindings>
              <KeyBinding Key="Delete" Command="{Binding RemoveSelectedInputsCommand}" />
            </ListBox.InputBindings>
          </ListBox>
          <StackPanel Grid.Column="1" Margin="8,0,0,0" Width="150">
            <Button Content="{DynamicResource Main_AddFiles}" Command="{Binding AddFilesCommand}" Margin="0,0,0,4" Padding="4" />
            <Button Content="{DynamicResource Main_AddFolder}" Command="{Binding AddFolderCommand}" Margin="0,0,0,4" Padding="4" />
            <Button Content="{DynamicResource Main_RemoveSelected}" Command="{Binding RemoveSelectedInputsCommand}" Margin="0,0,0,4" Padding="4" />
            <Button Content="{DynamicResource Main_ClearInputs}" Command="{Binding ClearInputsCommand}" Padding="4" />
          </StackPanel>
        </Grid>
      </GroupBox>

      <!-- Output folder -->
      <GroupBox Grid.Row="1" Header="{DynamicResource Main_Output}" Padding="6" Margin="0,6,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding OutputFolder, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center"
                   AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDropOutput" IsEnabled="{Binding CanEdit}" />
          <Button Grid.Column="1" Content="{DynamicResource Main_Browse}" Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" Padding="12,4" />
        </Grid>
      </GroupBox>

      <!-- Conditions: one row for each kind of setting -->
      <GroupBox Grid.Row="2" Header="{DynamicResource Main_Conditions}" Padding="6" Margin="0,6,0,0">
        <GroupBox.Resources>
          <!-- A text has no disabled look of its own: the labels of a locked item are shown dimmed too (FR-066). -->
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </GroupBox.Resources>
        <StackPanel>
          <!-- The folded part: the kinds of file and the conversion (FR-102). Closed, the line says what is chosen. Steps are always shown. -->
          <Expander x:Name="ConditionsExpander" IsExpanded="{Binding ConditionsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Margin="0,0,0,6"
                    ToolTip="{DynamicResource Main_Cond_FoldTip}">
            <Expander.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Main_Cond_Fold}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ConditionSummaryText, Mode=OneWay}" ToolTip="{Binding ConditionSummaryText, Mode=OneWay}"
                           Visibility="{Binding ConditionsCollapsedVisibility}" Margin="14,0,8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubtleTextBrush}" />
              </Grid>
            </Expander.Header>

          <!-- The folded part itself: the Expander shows it when it is open. -->
          <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- The kinds of file that are converted when a folder is given -->
          <TextBlock Grid.Row="0" Text="{DynamicResource Main_Cond_Targets}" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding CanEditNewRun}" />
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding CanEditNewRun}">
            <CheckBox x:Name="DocxBox" Content="docx" IsChecked="{Binding TypeDocx}" ToolTip="{DynamicResource Main_Cond_TypesNote}" VerticalAlignment="Center" Margin="0,0,20,0" />
            <CheckBox Content="xlsx" IsChecked="{Binding TypeXlsx}" ToolTip="{DynamicResource Main_Cond_TypesNote}" VerticalAlignment="Center" Margin="0,0,20,0" />
            <CheckBox Content="pptx" IsChecked="{Binding TypePptx}" ToolTip="{DynamicResource Main_Cond_TypesNote}" VerticalAlignment="Center" Margin="0,0,20,0" />
            <CheckBox Content="pdf" IsChecked="{Binding TypePdf}" ToolTip="{DynamicResource Main_Cond_TypesNote}" VerticalAlignment="Center" Margin="0,0,40,0" />
            <CheckBox Content="{DynamicResource Main_Cond_Recurse}" IsChecked="{Binding Recurse}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Who extracts the text of each kind (experimental). Shown when an extractor is registered. -->
          <TextBlock Grid.Row="1" Text="{DynamicResource Main_Cond_Extractor}" VerticalAlignment="Center" Margin="0,0,0,6" ToolTip="{DynamicResource Main_Cond_ExtractorTip}"
                     Visibility="{Binding ExtractorVisibility}" IsEnabled="{Binding CanEditNewRun}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding ExtractorVisibility}"
                      IsEnabled="{Binding CanEditNewRun}">
            <TextBlock Text="{DynamicResource Main_Cond_RowDocx}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding ExtractorChoices}" DisplayMemberPath="Display" SelectedValuePath="Name" SelectedValue="{Binding ExtractorDocx}" Width="120" Margin="0,0,16,0" />
            <TextBlock Text="{DynamicResource Main_Cond_RowXlsx}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding ExtractorChoices}" DisplayMemberPath="Display" SelectedValuePath="Name" SelectedValue="{Binding ExtractorXlsx}" Width="120" Margin="0,0,16,0" />
            <TextBlock Text="{DynamicResource Main_Cond_RowPptx}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding ExtractorChoices}" DisplayMemberPath="Display" SelectedValuePath="Name" SelectedValue="{Binding ExtractorPptx}" Width="120" Margin="0,0,16,0" />
            <TextBlock Text="{DynamicResource Main_Cond_RowPdf}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding ExtractorChoices}" DisplayMemberPath="Display" SelectedValuePath="Name" SelectedValue="{Binding ExtractorPdf}" Width="120" />
          </StackPanel>

          <!-- The options of each kind. Always shown (a file that is given is converted whatever the boxes say); grey when an extractor is chosen.
               Word has none, so it has no row. -->
          <TextBlock Grid.Row="2" Text="{DynamicResource Main_Cond_OptionsRow}" VerticalAlignment="Top" Margin="0,2,0,6" IsEnabled="{Binding CanEditNewRun}" />
          <Grid Grid.Row="2" Grid.Column="1" IsEnabled="{Binding CanEditNewRun}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Main_Cond_RowXlsx}" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding XlsxOptionsEnabled}" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding XlsxOptionsEnabled}" ToolTip="{Binding XlsxOptionsTip}" ToolTipService.ShowOnDisabled="True">
              <CheckBox Content="{DynamicResource Main_Cond_HiddenSheets}" IsChecked="{Binding IncludeHiddenSheets}" VerticalAlignment="Center" Margin="0,0,20,0" />
              <TextBlock Text="{DynamicResource Main_Cond_Excel}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <RadioButton GroupName="ExcelRange" Content="{DynamicResource Main_Cond_ExcelColumns}" IsChecked="{Binding ExcelColumns}" ToolTip="{DynamicResource Main_Cond_ExcelColumnsTip}" VerticalAlignment="Center" Margin="0,0,16,0" />
              <RadioButton GroupName="ExcelRange" Content="{DynamicResource Main_Cond_ExcelSheet}" IsChecked="{Binding ExcelSheet}" ToolTip="{DynamicResource Main_Cond_ExcelSheetTip}" VerticalAlignment="Center" Margin="0,0,16,0" />
              <RadioButton GroupName="ExcelRange" Content="{DynamicResource Main_Cond_ExcelPrintArea}" IsChecked="{Binding ExcelPrintArea}" ToolTip="{DynamicResource Main_Cond_ExcelPrintAreaTip}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{DynamicResource Main_Cond_RowPptx}" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding PptxOptionsEnabled}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding PptxOptionsEnabled}" ToolTip="{Binding PptxOptionsTip}" ToolTipService.ShowOnDisabled="True">
              <CheckBox Content="{DynamicResource Main_Cond_HiddenSlides}" IsChecked="{Binding IncludeHiddenSlides}" VerticalAlignment="Center" Margin="0,0,20,0" />
              <CheckBox Content="{DynamicResource Main_Cond_OffSlide}" IsChecked="{Binding IncludeOffSlideText}" ToolTip="{DynamicResource Main_Cond_OffSlideTip}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{DynamicResource Main_Cond_RowPdf}" VerticalAlignment="Center" Margin="0,0,0,6" IsEnabled="{Binding PdfOptionsEnabled}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding PdfOptionsEnabled}" ToolTip="{Binding PdfOptionsTip}" ToolTipService.ShowOnDisabled="True">
              <CheckBox Content="{DynamicResource Main_Cond_PdfText}" IsChecked="{Binding UsePdfText}" ToolTip="{DynamicResource Main_Cond_PdfTextTip}" VerticalAlignment="Center" Margin="0,0,20,0" />
              <TextBlock Text="{DynamicResource Main_Cond_PdfHint}" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Visibility="{Binding PdfHintVisibility}" />
            </StackPanel>
          </Grid>

          </Grid>
          </Expander>

          <!-- Steps: always shown, also when the part above is folded (FR-102) -->
          <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Step1 always runs: it is shown, and it cannot be changed (FR-039) -->
          <TextBlock Grid.Row="0" Text="Step1" VerticalAlignment="Center" Margin="0,0,0,6" />
          <WrapPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
            <CheckBox Content="{DynamicResource Main_Cond_Step1}" IsChecked="True" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="{DynamicResource Main_Cond_Step1Always}" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,20,0" />
            <!-- The engine and the size of the print images, and the bold and italic of the text, are settings of Step1 -->
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditNewRun}">
              <TextBlock Text="{DynamicResource Main_Cond_Engine}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox x:Name="EngineBox" ItemsSource="{Binding EngineChoices}" DisplayMemberPath="Name" SelectedValuePath="Kind"
                        SelectedValue="{Binding SelectedEngine}" Width="170" Margin="0,0,20,0" />
              <TextBlock Text="{DynamicResource Main_Cond_Dpi}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox x:Name="DpiBox" Text="{Binding DpiText, UpdateSourceTrigger=LostFocus}" Width="68" VerticalContentAlignment="Center" Margin="0,0,20,0" />
              <CheckBox Content="{DynamicResource Main_Cond_Emphasis}" IsChecked="{Binding Emphasis}" ToolTip="{DynamicResource Main_Cond_EmphasisTip}" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource Main_Cond_EmphasisNote}" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
          </WrapPanel>

          <TextBlock Grid.Row="1" Text="Step2" VerticalAlignment="Center" Margin="0,0,0,6" />
          <CheckBox Grid.Row="1" Grid.Column="1" Content="{DynamicResource Main_Cond_Step2}" IsChecked="{Binding Step2}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="0,0,0,6" />

          <TextBlock Grid.Row="2" Text="Step3" VerticalAlignment="Center" />
          <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <CheckBox Content="{DynamicResource Main_Cond_Step3}" IsChecked="{Binding Step3}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <CheckBox Content="{DynamicResource Main_Cond_VlmSeparate}" IsChecked="{Binding VlmSeparate}" IsEnabled="{Binding CanEditVlmSeparate}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="{DynamicResource Main_Cond_Tables}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox SelectedIndex="{Binding Step1TablesIndex}" IsEnabled="{Binding CanEditStep1Tables}" VerticalAlignment="Center" Margin="0,0,16,0" MinWidth="170">
              <ComboBoxItem Content="{DynamicResource Main_Cond_TablesVlm}" />
              <ComboBoxItem Content="{DynamicResource Main_Cond_TablesReplace}" />
              <ComboBoxItem Content="{DynamicResource Main_Cond_TablesOmit}" />
            </ComboBox>
            <CheckBox Content="{DynamicResource Main_Cond_DropRepeated}" ToolTip="{DynamicResource Main_Cond_DropRepeatedTip}" IsChecked="{Binding DropRepeatedTables}" IsEnabled="{Binding CanEditVlmSeparate}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="{DynamicResource Main_Cond_Connection}" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Text="{Binding ConnectionInUse, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Menu_VlmSettings}" Command="{Binding ConnectionSettingsCommand}" Padding="8,2" />
            <Button Content="{DynamicResource Menu_Prompts}" Command="{Binding PromptsCommand}" Padding="8,2" Margin="6,0,0,0" />
            <!-- The pages that Step3 reads: for one file only (FR-097) -->
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" IsEnabled="{Binding CanEditPages}" ToolTip="{Binding PagesTip}" ToolTipService.ShowOnDisabled="True">
              <TextBlock Text="{DynamicResource Main_Cond_Pages}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBox Text="{Binding PageRangeText, UpdateSourceTrigger=PropertyChanged}" Width="110" VerticalContentAlignment="Center" />
            </StackPanel>
          </WrapPanel>

          <!-- The prompt of each kind of file that Step3 sends to the VLM (FR-115) -->
          <TextBlock Grid.Row="3" Text="{DynamicResource Main_Cond_Prompt}" VerticalAlignment="Center" Margin="0,6,0,0" />
          <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding PromptChoices}" IsEnabled="{Binding CanEditPrompts}" Margin="0,6,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <ComboBox ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex}" MinWidth="150" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </Grid>
        </StackPanel>
      </GroupBox>

      <!-- Actions -->
      <!-- Three groups, each in a frame: the conversion, where a file converted before is written, and the file chosen in the list. -->
      <DockPanel Grid.Row="3" Margin="0,10,0,10" LastChildFill="False">
        <DockPanel.Resources>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style x:Key="ActionGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,4" />
          </Style>
        </DockPanel.Resources>
        <!-- The conversion (FR-129). The list of files decides which of the four can be pressed. -->
        <Border DockPanel.Dock="Left" Style="{StaticResource ActionGroup}">
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Main_Start}" Command="{Binding StartCommand}" MinWidth="90" Padding="12,6" Margin="0,0,8,0" FontWeight="SemiBold"
                    ToolTip="{DynamicResource Main_StartTip}" ToolTipService.ShowOnDisabled="True" />
            <Button Content="{DynamicResource Main_Resume}" Command="{Binding ResumeCommand}" Padding="12,6" Margin="0,0,8,0"
                    ToolTip="{DynamicResource Main_ResumeTip}" ToolTipService.ShowOnDisabled="True" />
            <Button Content="{DynamicResource Main_RedoAll}" Command="{Binding RedoAllCommand}" Padding="12,6" Margin="0,0,8,0"
                    ToolTip="{DynamicResource Main_RedoAllTip}" ToolTipService.ShowOnDisabled="True" />
            <Button Content="{DynamicResource Main_ChangedOnly}" Command="{Binding StartChangedCommand}" Padding="12,6" Margin="0,0,16,0"
                    ToolTip="{DynamicResource Main_ChangedOnlyTip}" ToolTipService.ShowOnDisabled="True" />
            <Button Content="{DynamicResource Main_Interrupt}" Command="{Binding InterruptCommand}" MinWidth="90" Padding="12,6" />
          </StackPanel>
        </Border>
        <!-- FR-129: what "Start" and "Redo all" do with a file that was converted before. -->
        <Border DockPanel.Dock="Left" Style="{StaticResource ActionGroup}" Margin="10,0,0,0"
                ToolTip="{DynamicResource Main_ExistingTip}" ToolTipService.ShowOnDisabled="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}">
            <TextBlock Text="{DynamicResource Main_Existing}" VerticalAlignment="Center" Margin="2,0,8,0" />
            <RadioButton GroupName="ExistingFolder" Content="{DynamicResource Main_ExistingNew}" IsChecked="{Binding NewFolder}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton GroupName="ExistingFolder" Content="{DynamicResource Main_ExistingSame}" IsChecked="{Binding SameFolder}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <!-- The file chosen in the list (FR-127: "Convert again" is the same as "Convert the selected files again" of the list's context menu). -->
        <Border DockPanel.Dock="Right" Style="{StaticResource ActionGroup}" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="PreviewButton" Content="{DynamicResource Main_Preview}" Click="OnPreviewClick" MinWidth="90" Padding="6"
                    IsEnabled="{Binding Selected.CanPreview, FallbackValue=False, TargetNullValue=False}"
                    ToolTip="{DynamicResource Main_PreviewTip}" ToolTipService.ShowOnDisabled="True" />
            <Button Content="{DynamicResource Main_ReconvertButton}" Click="OnReconvertClick" MinWidth="90" Padding="6" Margin="8,0,0,0"
                    ToolTip="{DynamicResource Main_ReconvertTip}" ToolTipService.ShowOnDisabled="True">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="IsEnabled" Value="{Binding CanEdit}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </Border>
      </DockPanel>

      <Grid Grid.Row="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="90" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="90" />
        </Grid.RowDefinitions>
        <!-- File list -->
        <DataGrid x:Name="FileGrid" Grid.Row="0" ItemsSource="{Binding Files}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" MouseDoubleClick="OnFileDoubleClick"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{DynamicResource Main_Preview}" Click="OnPreviewClick" IsEnabled="{Binding Selected.CanPreview, FallbackValue=False, TargetNullValue=False}" />
              <Separator />
              <MenuItem Header="{DynamicResource Main_OpenFolder}" Click="OnOpenFolderClick" IsEnabled="{Binding Selected.HasOutputFolder, FallbackValue=False, TargetNullValue=False}" />
              <MenuItem Header="{DynamicResource Main_OpenMarkdown}" Click="OnOpenMarkdownClick" IsEnabled="{Binding Selected.HasMarkdown, FallbackValue=False, TargetNullValue=False}" />
              <MenuItem Header="{DynamicResource Main_OpenVlm}" Click="OnOpenVlmClick" IsEnabled="{Binding Selected.HasVlm, FallbackValue=False, TargetNullValue=False}" />
              <Separator />
              <MenuItem Header="{DynamicResource Main_Reconvert}" Click="OnReconvertClick" ToolTip="{DynamicResource Main_ReconvertTip}"
                        IsEnabled="{Binding CanEdit}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource FailedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPageFailures}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource PartlyFailedBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding FileName}" Width="3*">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_File}" />
              </DataGridTextColumn.Header>
              <DataGridTextColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Setter Property="ToolTip" Value="{Binding FullPath}" />
                </Style>
              </DataGridTextColumn.CellStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding KindText}" Width="68">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_Type}" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding StateText}" Width="150">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_State}" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Step1" Binding="{Binding Step1Text}" Width="80" />
            <DataGridTextColumn Header="Step2" Binding="{Binding Step2Text}" Width="80" />
            <DataGridTextColumn Header="Step3" Binding="{Binding Step3Text}" Width="100" />
            <DataGridTextColumn Binding="{Binding PageCount}" Width="64">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_Pages}" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding DeletedPageCount}" Width="84">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_Deleted}" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding OutputText}" Width="140">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_Output}" />
              </DataGridTextColumn.Header>
              <DataGridTextColumn.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                  <Setter Property="ToolTip" Value="{Binding OutputFolderPath}" />
                </Style>
              </DataGridTextColumn.CellStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding UsageText}" Width="240">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_Usage}" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding Message}" Width="*">
              <DataGridTextColumn.Header>
                <TextBlock Text="{DynamicResource Main_Col_Message}" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- The two lists share the height: the splitter changes the size of each -->
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" Cursor="SizeNS" ToolTip="{DynamicResource Main_SplitterTip}" />

        <!-- The pages of the selected file -->
        <GroupBox Grid.Row="2" Header="{DynamicResource Main_PagesGroup}" Padding="4">
          <DataGrid ItemsSource="{Binding Selected.Pages}" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Binding="{Binding Index}" Width="80">
                <DataGridTextColumn.Header>
                  <TextBlock Text="{DynamicResource Main_Col_Page}" />
                </DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding Label}" Width="*">
                <DataGridTextColumn.Header>
                  <TextBlock Text="{DynamicResource Main_Col_Position}" />
                </DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridCheckBoxColumn Binding="{Binding IsDeleted, Mode=OneWay}" Width="110">
                <DataGridCheckBoxColumn.Header>
                  <TextBlock Text="{DynamicResource Main_Col_DeletedPage}" />
                </DataGridCheckBoxColumn.Header>
              </DataGridCheckBoxColumn>
              <DataGridTextColumn Binding="{Binding VlmState}" Width="120">
                <DataGridTextColumn.Header>
                  <TextBlock Text="{DynamicResource Main_Col_VlmState}" />
                </DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding UsageText}" Width="2*">
                <DataGridTextColumn.Header>
                  <TextBlock Text="{DynamicResource Main_Col_Usage}" />
                </DataGridTextColumn.Header>
                <DataGridTextColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="ToolTip" Value="{Binding UsageText}" />
                  </Style>
                </DataGridTextColumn.CellStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </GroupBox>
      </Grid>

      <!-- Status -->
      <TextBlock Grid.Row="5" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
  </DockPanel>
</Window>
