<Window x:Class="MarkPortO.App.ExtractorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/MarkPortO.ico" Title="{DynamicResource Ext_Title}" Height="700" Width="900" MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="ShowWhen" />
  </Window.Resources>
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <GroupBox Grid.Column="0" Header="{DynamicResource Ext_List}" Padding="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox Grid.Row="0" ItemsSource="{Binding Extractors}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="{DynamicResource Conn_Add}" Command="{Binding AddCommand}" Click="OnAddClicked" Padding="10,3" Margin="0,0,6,0" />
          <Button Content="{DynamicResource Conn_Remove}" Command="{Binding RemoveCommand}" Padding="10,3" Margin="0,0,6,0" />
          <Button Content="{DynamicResource Ext_Template}" Click="OnTemplateClicked" Padding="10,3">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{DynamicResource Ext_TemplateMarkItDown}" Command="{Binding AddMarkItDownCommand}" />
                <MenuItem Header="{DynamicResource Ext_TemplateDocling}" Command="{Binding AddDoclingCommand}" />
                <MenuItem Header="{DynamicResource Ext_TemplatePandoc}" Command="{Binding AddPandocCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Column="1" Header="{DynamicResource Ext_Selected}" Padding="10" Margin="10,0,0,0" IsEnabled="{Binding HasSelection}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid DataContext="{Binding Selected}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="{DynamicResource Conn_Name}" VerticalAlignment="Center" Margin="0,0,10,8" />
          <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />

          <TextBlock Grid.Row="1" Text="{DynamicResource Ext_Command}" VerticalAlignment="Center" Margin="0,0,10,8" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Command, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" ToolTip="{DynamicResource Ext_CommandTip}" />

          <TextBlock Grid.Row="2" Text="{DynamicResource Ext_Args}" VerticalAlignment="Top" Margin="0,4,10,0" />
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
            <TextBox Text="{Binding ArgsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinLines="4" MaxLines="8" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
            <TextBlock Text="{DynamicResource Ext_ArgsTip}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
          </StackPanel>

          <TextBlock Grid.Row="3" Text="{DynamicResource Ext_Output}" VerticalAlignment="Center" Margin="0,0,10,8" />
          <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding OutputItems}" SelectedIndex="{Binding OutputIndex}" Width="240" HorizontalAlignment="Left" Margin="0,0,0,8" />

          <TextBlock Grid.Row="4" Text="{DynamicResource Conn_Timeout}" VerticalAlignment="Center" Margin="0,0,10,8" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TimeoutText, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" Margin="0,0,0,8" />

          <TextBlock Grid.Row="5" Text="{DynamicResource Ext_WorkingDirectory}" VerticalAlignment="Center" Margin="0,0,10,8" />
          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding WorkingDirectory, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" ToolTip="{DynamicResource Ext_WorkingDirectoryTip}" />

          <TextBlock Grid.Row="6" Text="{DynamicResource Ext_Env}" VerticalAlignment="Top" Margin="0,4,10,0" />
          <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
            <TextBox Text="{Binding EnvText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinLines="2" MaxLines="5" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
            <TextBlock Text="{DynamicResource Ext_EnvTip}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
          </StackPanel>

          <TextBlock Grid.Row="7" Text="{DynamicResource Conn_Consent}" VerticalAlignment="Top" Margin="0,4,10,0" />
          <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,8">
            <CheckBox Content="{DynamicResource Ext_SendsExternally}" IsChecked="{Binding SendsExternally}" />
            <TextBlock Text="{Binding ConsentText}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding ConsentRequired, Converter={StaticResource ShowWhen}}">
              <Button Content="{DynamicResource Conn_Agree}" Click="OnAgreeClicked" IsEnabled="{Binding CanAgree}" Padding="12,3" Margin="0,0,8,0" />
              <Button Content="{DynamicResource Conn_Withdraw}" Click="OnWithdrawClicked" IsEnabled="{Binding CanWithdraw}" Padding="12,3" />
            </StackPanel>
          </StackPanel>

          <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource FailedBrush}" Margin="0,0,0,8" />

          <StackPanel Grid.Row="9" Grid.ColumnSpan="2">
            <Button Content="{DynamicResource Ext_Try}" Click="OnTryClicked" IsEnabled="{Binding NotBusy}" Padding="12,4" HorizontalAlignment="Left" ToolTip="{DynamicResource Ext_TryTip}" />
            <TextBox Text="{Binding TryResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" BorderThickness="0" Background="Transparent" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </GroupBox>
  </Grid>
</Window>
