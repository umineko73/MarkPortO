<Window x:Class="MarkPortO.App.PromptsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/MarkPortO.ico" Title="{DynamicResource Prompts_Title}" Height="520" Width="760" MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="{DynamicResource Prompts_Note}" />
    <TabControl Grid.Row="1" x:Name="Tabs">
      <TabItem Header="Word (docx)">
        <TextBox x:Name="DocxBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="6" />
      </TabItem>
      <TabItem Header="Excel (xlsx)">
        <TextBox x:Name="XlsxBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="6" />
      </TabItem>
      <TabItem Header="PowerPoint (pptx)">
        <TextBox x:Name="PptxBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="6" />
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="{DynamicResource Prompts_Reset}" Click="OnResetCurrent" Padding="10,3" Margin="0,0,8,0" />
      <Button Content="{DynamicResource Prompts_Close}" IsDefault="True" IsCancel="True" Padding="16,3" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
