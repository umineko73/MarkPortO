  <sys:String x:Key="Main_Cond_Step1Always">(always)</sys:String>
  <sys:String x:Key="Main_Cond_Step2">Put print images into the Markdown (built-in only)</sys:String>
  <sys:String x:Key="Main_Cond_Extractor">Extractor</sys:String>
  <sys:String x:Key="Main_Cond_ExtractorBuiltIn">built-in</sys:String>
  <sys:String x:Key="Main_Cond_ExtractorTip">An external command that is written in settings.json writes the Markdown. There are no pages marks, and the VLM results go to a file of their own.</sys:String>
