  <sys:String x:Key="Main_Cond_PagesOneFileTip">Pages can be chosen only when one file is converted.</sys:String>
  <sys:String x:Key="Main_Cond_PagesStep3OffTip">Step3 is off, so the pages are not used.</sys:String>
