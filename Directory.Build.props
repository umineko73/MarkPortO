<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
    <Version>0.1.3</Version>
    <Authors>umineko73</Authors>
    <Copyright>Copyright (C) 2026 umineko73</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/umineko73/MarkPortO</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/umineko73/MarkPortO</PackageProjectUrl>
  </PropertyGroup>
</Project>
